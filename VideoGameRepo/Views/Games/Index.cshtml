@model IEnumerable<VideoGameRepo.Models.Game>

@{
    ViewData["Title"] = "Index";
}

<div class="flex-container">
    <image src="/images/tm-logo-2025-v2.svg"/>
    <h1>Trade Me Catalogue</h1>
</div>

<div class="item-table">
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Image)
            </th>
                <th>
                    @Html.DisplayNameFor(model => model.Title) (@Html.DisplayNameFor(model => model.Category))
                </th>

            <th>
                @Html.DisplayNameFor(model => model.Cost)
            </th>
            <th>
                @Html.DisplayNameFor(Model => Model.Shipping)
            </th>
            <th>
                Total Cost
            </th>
             <th>
                 @Html.DisplayNameFor(Model => Model.Status)
             </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
                <tr>
                    <td>@if (!string.IsNullOrEmpty(item.Image)){
                            <img src="~/images/@item.Image" alt="@item.Title" width="100" class="img-thumbnail" />
                    } else
                    {
        <!-- Optional: Show a placeholder if no image exists -->
        <img src="~/images/no-image.png" alt="No Image Available" width="100" class="img-thumbnail" />
    }
                        </td>
            <td>
                @* @Html.DisplayFor(modelItem => item.Title)  *@
                @Html.DisplayFor(modelItem => item.Title) @($"({item.Category})")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cost)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Shipping)
            </td>
            <td>
                @(item.Cost + item.Shipping)
            </td>
             <td>
                @* @Html.DisplayFor(modelItem => item.Status) *@
                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" style="display:inline">
                       @if (item.Status)
                           {
                               <button type="submit" class="btn btn-sm btn-success">Sold</button>
                           }
                           else
                           {
                               <button type="submit"' class-="btn btn-sm btn-danger">Unsold</button>
                           }
                </form>
             </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
